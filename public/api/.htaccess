# CoolTech API Routing Configuration
# Enable URL rewriting for clean API endpoints

RewriteEngine On

# Handle API routes
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Route to specific PHP files based on path
RewriteRule ^products/?$ products.php [QSA,L]
RewriteRule ^products/(.+)$ products.php?id=$1 [QSA,L]
RewriteRule ^services/?$ services.php [QSA,L]
RewriteRule ^services/(.+)$ services.php?id=$1 [QSA,L]
RewriteRule ^quotes/?$ quotes.php [QSA,L]
RewriteRule ^bookings/?$ bookings.php [QSA,L]
RewriteRule ^contact/?$ contact.php [QSA,L]

# Admin routes
RewriteRule ^admin/auth/?$ admin/auth.php [QSA,L]
RewriteRule ^admin/dashboard/?$ admin/dashboard.php [QSA,L]
RewriteRule ^admin/products/?$ admin/products.php [QSA,L]
RewriteRule ^admin/quotes/?$ admin/quotes.php [QSA,L]
RewriteRule ^admin/bookings/?$ admin/bookings.php [QSA,L]
RewriteRule ^admin/contacts/?$ admin/contacts.php [QSA,L]
RewriteRule ^admin/upload/?$ admin/upload.php [QSA,L]

# CORS Headers for API access
<IfModule mod_headers.c>
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization"
</IfModule>

# Handle OPTIONS preflight requests
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ - [R=200,L]

# Prevent direct access to PHP files that should only be included
<FilesMatch "^(config|send-email|email-templates)\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>
